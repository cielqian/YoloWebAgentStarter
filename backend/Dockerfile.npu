# 昇腾 310P3 推理卡变体：CANN 8.0.RC1 / torch-npu 2.1.0.post6 / torch 2.1.0
# CANN toolkit 从宿主机挂载（见 docker-compose.npu.yml），镜像内只装 torch-npu 适配层。
FROM python:3.10-slim

ARG TORCH_VERSION=2.1.0
ARG TORCH_NPU_VERSION=2.1.0.post6

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend \
    YWA_HOST=0.0.0.0 \
    YWA_PORT=8000 \
    YWA_DATA_DIR=/app/data \
    YWA_IMPORT_ROOT=/app/data/imports

# ultralytics 会连带安装非 headless 的 opencv-python，需要 libGL；headless 自身需要 libglib2.0。
# 代理环境下纯 HTTP 的 apt 请求会被 502，先切到 https 源。
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt /app/backend/requirements.txt

# 版本必须与宿主机 CANN 配套：npu-smi 24.1.rc1 -> CANN 8.0.RC1 -> torch-npu 2.1.0.post6
RUN pip install --no-cache-dir torch==$TORCH_VERSION --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir torch-npu==$TORCH_NPU_VERSION \
    && pip install --no-cache-dir -r /app/backend/requirements.txt

COPY . /app/backend
RUN chmod +x /app/backend/entrypoint-npu.sh

EXPOSE 8000

ENTRYPOINT ["/app/backend/entrypoint-npu.sh"]
